GLPI_URL=https://tu-servidor/apirest.php
GLPI_APP_TOKEN=tu_app_token_aqui
GLPI_USER_TOKEN=tu_user_token_aqui

# Nombre del grupo de GLPI del que sale todo: los tickets que se muestran y
# quien puede entrar al sistema. Si en GLPI le cambian el nombre al grupo, se
# corrige aca y listo; con el nombre escrito en el codigo, el login dejaba de
# funcionar sin que el error dijera por que.
# Vacio = "Soporte Aplicaciones", que es como venia.
GLPI_GROUP_NAME=

# Certificado de la CA que firmo el certificado de GLPI, en formato .pem.
# Vacio = no se valida el certificado (es como venia hasta ahora). Anda igual,
# pero por esa conexion viajan los tokens de GLPI, asi que en el servidor
# conviene cargarlo: quien se meta en el medio de la red deja de poder leerlos.
# Se exporta desde el navegador (ver el certificado de GLPI -> ruta de
# certificacion -> la CA de arriba -> exportar como Base 64) y se guarda en una
# ruta fija del server.
#   Ejemplo: GLPI_CA_BUNDLE=D:\certs\ca-municipio.pem
# Si la ruta esta mal escrita, el backend corta al arrancar y lo dice.
GLPI_CA_BUNDLE=

# Telegram
TELEGRAM_BOT_TOKEN=tu_bot_token_aqui

# Chat ID del jefe (recibe todas las notificaciones)
TELEGRAM_BOSS_CHAT_ID=123456789

# Tecnicos: formato glpi_user_id:telegram_chat_id separados por coma
# El tecnico asignado al ticket recibe la notificacion ademas del jefe
# Ejemplo: 42:123456789,87:987654321
# Entradas con chat_id vacio (ej: 87:) son ignoradas automaticamente por el parser
TELEGRAM_TECH_IDS=

# === Autenticacion ===
# Clave para firmar la cookie de sesion. OBLIGATORIA: el backend no arranca sin ella.
# Generar una propia con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# users_id de GLPI que arranca como jefe. Alguien tiene que poder dar el primer
# permiso desde el menu de usuarios; el resto entra como tecnico.
JEFE_INICIAL=

# Active Directory. El login valida por bind NTLM contra el controlador de
# dominio: desafio-respuesta, la contrasena no viaja por la red, y no hace
# falta usuario de servicio.
#   LDAP_SERVER  : host del DC
#                  (se descubre con: nslookup -type=SRV _ldap._tcp.dc._msdcs.TU-DOMINIO)
#   LDAP_NETBIOS : nombre corto del dominio (el de DOMINIO\usuario). NTLM lo exige.
#   LDAP_PORT    : 389. NTLM no necesita LDAPS para proteger la credencial.
LDAP_SERVER=
LDAP_NETBIOS=
LDAP_PORT=389

# Puertos (cambiar si el puerto por defecto ya esta en uso en tu maquina)
BACKEND_PORT=8000
FRONTEND_PORT=5173

# === Entorno ===
# DEV=1 en la maquina de uno: prende el recargado automatico de uvicorn y el
# CORS hacia el servidor de Vite. En el servidor productivo NO se define.
DEV=1

# Cookie de sesion solo por HTTPS. Dejar vacio mientras el server termine en
# HTTP puro: prendido, la cookie no viaja y nadie puede entrar. Poner 1 en
# cuanto haya certificado.
COOKIE_HTTPS_ONLY=

# Cada cuantos segundos se le pregunta a GLPI si hay novedades. Por defecto 30.
# En produccion se puede subir para no castigar a GLPI.
POLL_INTERVAL=30

# Endpoints de diagnostico (/api/debug/...). En desarrollo estan prendidos
# solos; en el server se prenden con 1 nada mas que cuando hay que diagnosticar
# algo, y se vuelven a apagar. Exigen rol jefe igual, pero devuelven config
# interna y datos crudos de GLPI: es superficie que no hace falta tener.
DEBUG_ENDPOINTS=

# Donde vive dashboard.db. Vacio = en la raiz del proyecto, que es lo comodo en
# la maquina de uno. En el server conviene una carpeta FUERA del repo: los datos
# quedan separados del codigo y ningun despliegue puede pisarlos. La carpeta
# tiene que existir; si no, el backend corta al arrancar y lo dice.
#   Ejemplo: DB_PATH=D:\datos\dashboard-glpi\dashboard.db
DB_PATH=

# === Logs ===
# LOG_LEVEL : DEBUG, INFO, WARNING o ERROR. Por defecto INFO.
# LOG_FILE  : archivo donde escribir. Vacio = por consola, que es lo comodo en
#             la maquina de uno. Corriendo como servicio no hay consola, asi que
#             en el server hay que definirlo o los mensajes se pierden. Conviene
#             una ruta fuera de la carpeta del proyecto, para que un despliegue
#             no se lleve puestos los logs. Rota solo a los 5 MB.
LOG_LEVEL=INFO
LOG_FILE=
